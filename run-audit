#!/usr/bin/env bash
# Loom E2E — one program; output → projects/<curriculum>/e2e/runs/<model>/
# Usage: ./run-audit <curriculum-id> [run_project.py flags...]
# Example: ./run-audit dallas-career-2026 --with-graph --graph-run nemotron3-nano-30b
#          ./run-audit dallas-career-2026 --only engineering
# Review: UI curriculum picker → E2E · <model>  (see docs/E2E.md)
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <curriculum-id> [flags...]" >&2
  echo "  curriculum-id = folder under projects/" >&2
  echo "  writes → projects/<id>/e2e/runs/<model>/  (unless --allow-live-root)" >&2
  exit 2
fi
PROJECT="$1"
shift
exec python3 "$DIR/run_project.py" --project "$PROJECT" "$@"
