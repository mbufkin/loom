# Hosted Loom — copy to .env.local. Never commit real values.
# Generate AUTH_SECRET with: openssl rand -base64 32

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Comma-separated Google emails. hd is skipped for these. Fail closed if empty.
OPERATOR_EMAILS=mbufkin@dallasisd.org

# Comma-separated invited Admin emails. The account must ALSO have a Workspace
# hd (that names the District). Fail closed if empty: nobody gets Workspace.
ADMIN_EMAILS=mbufkin@dallasisd.org

# Never put NVIDIA_API_KEY here. That secret lives on the Pi Worker only.

# Loom app server on the Pi (see deploy/hosted-app/RUNBOOK.md). The secret must
# equal LOOM_PROXY_SECRET in the Pi's app.env. Server-side only; never NEXT_PUBLIC_.
LOOM_API_URL=
LOOM_PROXY_SECRET=

# Cloudflare R2 — Packet archive (amended off Vercel Blob).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loom-packets
