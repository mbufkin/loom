# Hosted Loom — copy to .env.local. Never commit real values.
# Generate AUTH_SECRET with: openssl rand -base64 32

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Comma-separated Google emails. hd is skipped for these. Fail closed if empty.
OPERATOR_EMAILS=mbufkin@dallasisd.org

# Never put NVIDIA_API_KEY here. That secret lives on Fly only.

# Cloudflare R2 — Packet archive (amended off Vercel Blob).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loom-packets
