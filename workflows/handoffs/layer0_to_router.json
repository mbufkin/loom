{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/handoffs/layer0_to_router.json",
  "title": "Layer 0 → Loom router handoff",
  "description": "One document after decompose+classify, before routing.",
  "type": "object",
  "required": ["doc_id", "doc_type"],
  "properties": {
    "doc_id": { "type": "string", "minLength": 1 },
    "source_file": { "type": "string" },
    "doc_type": {
      "type": "string",
      "description": "Pedagogical type from classify (filename and/or Layer 0 prior)."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "chunk_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "element_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
